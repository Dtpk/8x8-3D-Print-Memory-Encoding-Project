// --- 1. USER INPUT ---
YOUR_TEXT = "testingsquare"; 
SHAPE_STYLE = "square"; // Toggle between "square" and "round"

// --- 2. HARDWARE TOGGLES ---
ENABLE_KEYCHAIN_HOLE = false; 
ENABLE_RAISED_NOTCH  = true; // Generates the "L" Frame around the first bit

// --- 3. CONFIGURATION ---
GRID_SIZE = 8;
CELL_SIZE = 4.0;       // 4mm grid cell spacing
PLATE_THICKNESS = 0.5;   // Determines main plate thickness
SHEET_THICKNESS = 0.4;   // Determines transparent sheet thickness

PELLET_HOLE_R = 1.0;  
DASH_W = 2.0;          
DASH_H = 0.6;          

// Grid bounding dimensions
GRID_W = GRID_SIZE * CELL_SIZE;
GRID_H = GRID_SIZE * CELL_SIZE;

// Margins and total sizing depending on shape and keychain
BORDER = ENABLE_KEYCHAIN_HOLE ? 4.0 : 0.0;
TOTAL_W = GRID_W + BORDER;
TOTAL_H = GRID_H;

// Center calculation for round version (gives enough padding for the grid + keychain)
ROUND_R = (SHAPE_STYLE == "round") ? (max(TOTAL_W, TOTAL_H) * 0.707) + (ENABLE_KEYCHAIN_HOLE ? 2.0 : 0.0) : 0;

// --- 4. AUDITED HUFFMAN KEY LOOKUP ---
function get_huffman(char) = 
    (char == " ") ? [0,0,0] :
    (char == "P") ? [0,0,1,0,0,0,0,0] :
    (char == "O") ? [0,0,1,0,0,0,0,1] :
    (char == "j") ? [0,0,1,0,0,0,1,0] :
    (char == "S") ? [0,0,1,0,0,0,1,1] :
    (char == "g") ? [0,0,1,0,1,1] :
    (char == "m") ? [0,0,1,0,1] :
    (char == "r") ? [0,0,1,1] :
    (char == "s") ? [0,1,0,0] :
    (char == "?") ? [0,1,0,1,0,0,0,0,0] :
    (char == "!") ? [0,1,0,1,0,0,0,0,1] :
    (char == "A") ? [0,1,0,1,0,0,1] :
    (char == "I") ? [0,1,0,1,0,0,1,0] :
    (char == "X") ? [0,1,0,1,0,0,1,1,0] :
    (char == "Q") ? [0,1,0,1,0,0,1,1,1] :
    (char == "T") ? [0,1,0,1,0,1,0,0] :
    (char == "E") ? [0,1,0,1,0,1,0,1] :
    (char == "k") ? [0,1,0,1,0,1,1] :
    (char == "u") ? [0,1,0,1,1] :
    (char == "n") ? [0,1,1,0] :
    (char == "i") ? [0,1,1,1] :
    (char == "o") ? [1,0,0,0] :
    (char == "3") ? [1,0,0,1,0,0,0,0,0] :
    (char == "0") ? [1,0,0,1,0,0,0,0,1] :
    (char == "7") ? [1,0,0,1,0,0,0,1,0] :
    (char == "6") ? [1,0,0,1,0,0,0,1,1] :
    (char == "v") ? [1,0,0,1,0,0,1] :
    (char == "p") ? [1,0,0,1,0,1] :
    (char == "c") ? [1,0,0,1,1] :
    (char == "a") ? [1,0,1,0] :
    (char == "5") ? [1,0,1,1,0,0,0,0,0] :
    (char == "4") ? [1,0,1,1,0,0,0,0,1] :
    (char == "x") ? [1,0,1,1,0,0,0,1] :
    (char == "K") ? [1,0,1,1,0,0,1,0,0] :
    (char == "J") ? [1,0,1,1,0,0,1,0,1] :
    (char == "9") ? [1,0,1,1,0,0,1,1,0] :
    (char == "8") ? [1,0,1,1,0,0,1,1,1] :
    (char == "Y") ? [1,0,1,1,0,1,0,0,0] :
    (char == "V") ? [1,0,1,1,0,1,0,0,1] :
    (char == "-") ? [1,0,1,1,0,1,0,1,0] :
    (char == "2") ? [1,0,1,1,0,1,0,1,1] :
    (char == "b") ? [1,0,1,1,0,1,1] :
    (char == "d") ? [1,0,1,1,1] :
    (char == "t") ? [1,1,0,0] :
    (char == "y") ? [1,1,0,1,0,0,0] :
    (char == "1") ? [1,1,0,1,0,0,1,0,0] : 
    (char == "q") ? [1,1,0,1,0,0,1,0,1] :
    (char == "L") ? [1,1,0,1,0,0,1,1,0] :
    (char == "G") ? [1,1,0,1,0,0,1,1,1] :
    (char == "f") ? [1,1,0,1,0,1] :
    (char == "l") ? [1,1,0,1,1] :
    (char == "W") ? [1,1,1,0,0,0,0,0,0] :
    (char == "U") ? [1,1,1,0,0,0,0,0,1] :
    (char == "F") ? [1,1,1,0,0,0,0,1,0] :
    (char == "D") ? [1,1,1,0,0,0,0,1,1] :
    (char == "w") ? [1,1,1,0,0,0,1] :
