    (char == "h") ? [1,1,1,0,1] :
    (char == "e") ? [1,1,1,1] :
    [0]; 

// --- 5. FLATTENING AND BITSTREAM LOGIC ---
function encode_string(str, idx=0, current=[]) = 
    idx >= len(str) ? current : 
    encode_string(str, idx + 1, concat(current, get_huffman(str[idx])));

BIT_STREAM = encode_string(YOUR_TEXT);

function get_bit(x, y) = 
    let(bit_index = y * GRID_SIZE + x)
    bit_index < len(BIT_STREAM) ? BIT_STREAM[bit_index] : 0; 

// --- Helper module to switch between plate shapes ---
module base_shape(h) {
    if (SHAPE_STYLE == "round") {
        // Center the cylinder around the grid center for equal spacing
        translate([TOTAL_W / 2, TOTAL_H / 2, 0])
            cylinder(h = h, r = ROUND_R, $fn=100);
    } else {
        cube([TOTAL_W, TOTAL_H, h]);
    }
}

// --- Helper for keychain hole positioning ---
module keychain_hole_cutter(h) {
    if (ENABLE_KEYCHAIN_HOLE) {
        if (SHAPE_STYLE == "round") {
            // Position the keychain hole near the top-left outer boundary of the circle
            angle = 135; // Top-left direction
            hole_dist = ROUND_R - 3.0; // Pushed near the edge
            translate([TOTAL_W/2 + cos(angle)*hole_dist, TOTAL_H/2 + sin(angle)*hole_dist, -1])
                cylinder(h = h, r = 1.25, $fn=30);
        } else {
            // Original top-left corner placement for square
            translate([BORDER / 2, TOTAL_H - (BORDER / 2), -1])
                cylinder(h = h, r = 1.25, $fn=30); 
        }
    }
}

// --- 6. 3D GEOMETRY GENERATOR ---
union() {
    
    // 1. MAIN BODY: Gray plate with data holes and keychain hole
    color([0.2, 0.2, 0.2]) { 
        difference() {
            base_shape(PLATE_THICKNESS);
            
            // Generate Data Holes
            for (y = [0 : GRID_SIZE-1]) {
                for (x = [0 : GRID_SIZE-1]) {
                    pos_x = (x * CELL_SIZE) + (CELL_SIZE / 2) + BORDER;
                    pos_y = ((GRID_SIZE - 1 - y) * CELL_SIZE) + (CELL_SIZE / 2);
                    
                    bit = get_bit(x, y);
                    
                    translate([pos_x, pos_y, -1]) { 
                        if (bit == 1) {
                            cylinder(h = PLATE_THICKNESS + 2, r = PELLET_HOLE_R, $fn=30);
                        } else {
                            translate([-DASH_W/2, -DASH_H/2, 0])
                                cube([DASH_W, DASH_H, PLATE_THICKNESS + 2]);
                        }
                    }
                }
            }
            
            // Subtraction of keychain hole from main body
            keychain_hole_cutter(PLATE_THICKNESS + 2);
        }
    }
    
    // 2. TRANSPARENT OVERLAYS: Solid sheets with ONLY keychain hole cut out
    color([0, 1, 0, 0.2]) {
        difference() {
            union() {
                // Bottom sheet
                translate([0, 0, -SHEET_THICKNESS])
                    base_shape(SHEET_THICKNESS);
                // Top sheet
                translate([0, 0, PLATE_THICKNESS])
                    base_shape(SHEET_THICKNESS);
            }
            
            // Subtraction of keychain hole from transparent sheets
            total_depth = PLATE_THICKNESS + (SHEET_THICKNESS * 2) + 4;
            translate([0, 0, -SHEET_THICKNESS - 1])
                keychain_hole_cutter(total_depth);
        }
    }

    // 3. "L" FRAME BUMP: Positioned relative to grid (0,0) [Top-Left Data Position]
    if (ENABLE_RAISED_NOTCH) {
        color([0.8, 0.2, 0.2]) { // Highlighted Red in OpenSCAD
            // Left Vertical leg of the L
            translate([BORDER + 0.2, TOTAL_H - CELL_SIZE + 0.2, PLATE_THICKNESS])
                cube([0.6, CELL_SIZE - 0.4, 0.8]);
            
            // Top Horizontal leg of the L
            translate([BORDER + 0.2, TOTAL_H - 0.8, PLATE_THICKNESS])
                cube([CELL_SIZE - 0.4, 0.6, 0.8]);
        }
    }
}
